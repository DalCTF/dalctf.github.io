---
import { Image } from "astro:assets";

interface MemberEntry {
  name: string;
  profilePicture: ImageMetadata;
  profileAlt?: string;
  categories: string[];
  bio: string;
}

interface Props {
  member: MemberEntry;
}

const { member } = Astro.props;
---

<article class="member-card">
  <Image
    class="profile-picture"
    src={member.profilePicture}
    alt={member.profileAlt ?? `${member.name} profile picture`}
    width={144}
    height={144}
  />
  <div>
    <h3>{member.name}</h3>
    <div class="categories" aria-label={`${member.name} categories`}>
      {member.categories.map((category) => <span class="category-bean">{category}</span>)}
    </div>
    <p>{member.bio}</p>
  </div>
</article>

<style lang="scss">
  @use "../styles/variables" as *;

  .member-card {
    border: 3px solid $accent-color-dark;
    border-radius: $radius;
    align-items: center;
    display: grid;
    grid-template-columns: 144px 1fr;
    gap: 24px;
    padding: 24px;
  }

  .profile-picture {
    background: $background-secondary-color;
    border-radius: 50%;
    height: 144px;
    object-fit: cover;
    width: 144px;
  }

  h3 {
    margin-bottom: 10px;
  }

  .categories {
    flex-wrap: wrap;
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }

  .category-bean {
    background: $background-secondary-color;
    border: 2px solid $accent-color-light;
    border-radius: 999px;
    color: $foreground-color;
    display: inline-flex;
    font-family: $code-font;
    font-size: 0.875rem;
    line-height: 1rem;
    min-width: 44px;
    justify-content: center;
    padding: 7px 12px;
  }

  @media screen and (max-width: $breakpoint-phone) {
    .member-card {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }
</style>
